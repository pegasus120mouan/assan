APP_NAME="ASSAN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ovl-shop.test

APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ovl-shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shop
SHOP_CURRENCY=XOF
SHOP_CURRENCY_LABEL=FCFA
SHOP_EMAIL=contact@example.com
SHOP_PHONE=
SHOP_SAV_PHONE=
SHOP_WHATSAPP_NUMBER=
SHOP_ADDRESS=

# Default administrator (used by seeders — never commit a real password)
ADMIN_NAME="Administrateur OVL"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

CART_ABANDONED_AFTER_HOURS=48

# WhatsApp Business API (leave empty until integration is activated)

# WhatsApp Business API (leave empty until integration is activated)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payments (no live credentials)
PAYMENT_DEFAULT_GATEWAY=cash_on_delivery
PAYMENT_COD_ENABLED=true
PAYMENT_ORANGE_MONEY_ENABLED=false
PAYMENT_ORANGE_MONEY_API_URL=
PAYMENT_ORANGE_MONEY_API_KEY=
PAYMENT_MTN_MONEY_ENABLED=false
PAYMENT_MTN_MONEY_API_URL=
PAYMENT_MTN_MONEY_API_KEY=
PAYMENT_MOOV_MONEY_ENABLED=false
PAYMENT_MOOV_MONEY_API_URL=
PAYMENT_MOOV_MONEY_API_KEY=
PAYMENT_WAVE_ENABLED=false
PAYMENT_WAVE_API_URL=
PAYMENT_WAVE_API_KEY=

# Delivery
DELIVERY_PROVIDER=internal
DELIVERY_STANDARD_FEE=2000
OVL_DELIVERY_API_URL=
OVL_DELIVERY_API_KEY=
